# Copia este archivo a .env y completa los valores en el equipo de prueba.
APP_ENV=development
API_PORT=8001
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@192.168.1.86:5432/totem_municipal
TOKEN_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://192.168.1.85:5500
TOTEM_API_URL=http://127.0.0.1:8001
LDAP_HOST=totem-server
LDAP_DOMAIN=totem.lan
LDAP_BASE_DN=dc=totem,dc=lan
LDAP_CA_CERT=certs/ldap-ca.pem
# Lista de UID LDAP con privilegios de administrador; separa múltiples usuarios por coma.
TOTEM_ADMIN_USERS=Dmunoz
# Mantén aquí los funcionarios normales en formato uid=área separados por punto y coma.
LDAP_STAFF_AREAS=prueba.social=Departamento Social
# Directorio de adjuntos; debe coincidir con la ubicación usada por el servidor.
UPLOAD_DIR=uploads

# Recuperación de contraseña por correo (Gmail requiere contraseña de aplicación).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo-remitente@example.com
SMTP_PASSWORD=REEMPLAZAR_POR_CONTRASENA_DE_APLICACION
SMTP_FROM=correo-remitente@example.com
SMTP_STARTTLS=true
